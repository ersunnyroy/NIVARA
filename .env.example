# ---------------------------------------------------------------------------
# NIVARA configuration. Copy to `.env` (never commit real values).
# ---------------------------------------------------------------------------
ENVIRONMENT=development            # development | production
# REQUIRED in production: long random values. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
COOKIE_SECURE=false                # true behind HTTPS
ALLOWED_ORIGINS=http://localhost:3000

# Database / cache (docker-compose defaults; host ports chosen to avoid clashes)
POSTGRES_USER=nivara
POSTGRES_PASSWORD=nivara
POSTGRES_DB=nivara
DB_PORT=5442
REDIS_PORT=6381
# DB_IMAGE=timescale/timescaledb:latest-pg16   # optional: enables TimescaleDB hypertables
DATABASE_URL=postgresql+psycopg://nivara:nivara@localhost:5442/nivara
REDIS_URL=redis://localhost:6381/0

# Official NSE data (no credentials needed). Keep the request interval polite.
NSE_ENABLED=true
NSE_WEBSITE_API_ENABLED=true
NSE_MIN_REQUEST_INTERVAL_SEC=1.0
DATA_CACHE_DIR=./var/cache

# OPTIONAL real-time quotes (only one needed). Without these the app is EOD-only and says so.
UPSTOX_ACCESS_TOKEN=               # Upstox API v2 access token (daily)
KITE_API_KEY=                      # Zerodha Kite Connect api_key
KITE_ACCESS_TOKEN=                 # Kite Connect access_token (daily)

# OPTIONAL secondary news feeds (comma-separated RSS URLs from reputable, permitted sources)
NEWS_RSS_FEEDS=

# OPTIONAL AI explanations (Claude). Without it, deterministic explanations are shown.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
AI_ENABLED=true

# OPTIONAL notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_WEBHOOK_URL=

# OPTIONAL observability
SENTRY_DSN=
LOG_LEVEL=INFO
LOG_JSON=true

# OPTIONAL: create an admin on `python -m app.cli seed` (otherwise first web sign-up becomes admin)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
